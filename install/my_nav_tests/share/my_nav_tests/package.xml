<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypattern="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>my_nav_tests</name>
  <version>0.1.0</version>
  <description>Minimal Industrial Nav2 Testing Package</description>
  <maintainer email="dev@example.com">DevOps Engineer</maintainer>
  <license>Apache-2.0</license>

  <!-- Βασικές εξαρτήσεις εκτέλεσης (ROS 2 & Messages) -->
  <depend>rclpy</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- Εξαρτήσεις για τα Tests -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
